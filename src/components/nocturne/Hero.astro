---
// src/components/nocturne/Hero.astro
import { ui, getLang } from '../../i18n/ui';
const lang = getLang(Astro.currentLocale);
const t = ui[lang].hero;
---
<header class="hero">
  <div class="bg">
    <img src="/assets/img/pruebas-1.jpg" alt="" fetchpriority="high" />
  </div>
  <div class="inner">
    <p class="kick rv in">{t.kick}</p>
    <h1 class="rv in d1" set:html={t.h1Html}></h1>
    <p class="sub rv in d2">{t.sub}</p>
    <div class="cta rv in d3">
      <a class="btn-t" href="#contacto">{t.ctaQuote}</a>
      <a class="btn-o" href="#casos">{t.ctaCases}</a>
    </div>
    <div class="stats rv in d4">
      {t.stats.map((s) => (
        <div class="stat">
          <div class="n">{s.n}</div>
          <div class="l">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</header>
