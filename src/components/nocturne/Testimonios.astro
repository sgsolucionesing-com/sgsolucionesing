---
// src/components/nocturne/Testimonios.astro
---
<section class="sec quote">
  <div class="bg" aria-hidden="true">
    <img src="/assets/img/portada-principal.jpg" alt="" />
  </div>
  <div class="wrap">
    <div class="mark">&quot;</div>
    <div class="qtrack" id="qtrack">
      <div class="qitem on" data-name="Jefe de Mantenimiento" data-org="Planta de alimentos · Barranquilla" data-logo="">
        <blockquote>Pasamos de perseguir fallas a operar con datos. Hoy vemos cada consumo y anticipamos las paradas antes de que ocurran.</blockquote>
      </div>
      <div class="qitem" data-name="Coordinador de Energía" data-org="Cementera · Barranquilla" data-logo="">
        <blockquote>El factor de potencia se estabilizó y las penalizaciones desaparecieron. La inversión se pagó sola en meses.</blockquote>
      </div>
      <div class="qitem" data-name="Gerente de Planta" data-org="Industria · Costa Caribe" data-logo="">
        <blockquote>Por fin tenemos trazabilidad del consumo por área. Las decisiones ahora se toman con datos, no con supuestos.</blockquote>
      </div>
    </div>
    <figure class="qmeta">
      <img class="qlogo" id="qlogo" alt="" />
      <figcaption id="qcap"></figcaption>
    </figure>
    <div class="qdots" id="qdots" role="tablist" aria-label="Testimonios"></div>
  </div>
</section>

<script is:inline>
  (function(){
    const items=[...document.querySelectorAll('#qtrack .qitem')];
    if(!items.length)return;
    const logo=document.getElementById('qlogo'),cap=document.getElementById('qcap'),dots=document.getElementById('qdots');
    let i=0,timer;
    items.forEach((_,n)=>{const b=document.createElement('button');b.className='qdot'+(n===0?' on':'');b.setAttribute('role','tab');b.setAttribute('aria-label','Testimonio '+(n+1));b.onclick=()=>{go(n);reset();};dots.appendChild(b);});
    const dotEls=[...dots.children];
    function render(){const f=items[i];const src=f.dataset.logo;if(src){logo.src=src;logo.style.display='';}else{logo.removeAttribute('src');logo.style.display='none';}cap.innerHTML='— '+f.dataset.name+'<b>'+f.dataset.org+'</b>';}
    function go(n){items[i].classList.remove('on');dotEls[i].classList.remove('on');i=(n+items.length)%items.length;items[i].classList.add('on');dotEls[i].classList.add('on');render();}
    function reset(){clearInterval(timer);timer=setInterval(()=>go(i+1),5500);}
    render();reset();
    const sec=document.querySelector('.quote');
    sec.addEventListener('mouseenter',()=>clearInterval(timer));
    sec.addEventListener('mouseleave',reset);
  })();
</script>
