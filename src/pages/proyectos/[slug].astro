---
// src/pages/proyectos/[slug].astro — Detalle de proyecto (ES). Cuerpo en PageProyecto.
import { getCollection } from 'astro:content';
import PageProyecto from '../../components/PageProyecto.astro';

export async function getStaticPaths() {
  const items = await getCollection('proyectos', (e) => !e.id.startsWith('en/'));
  return items.map((proyecto) => ({
    params: { slug: proyecto.slug || proyecto.id.split('/').pop()?.replace(/\.mdx?$/, '') },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await proyecto.render();
---
<PageProyecto proyecto={proyecto}><Content slot="body" /></PageProyecto>
