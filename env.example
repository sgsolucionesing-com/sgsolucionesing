# Variables de entorno del sitio. Copiar a .env para desarrollo local, y
# cargarlas en Dokploy (pestaña Environment de la app) para producción.
#
# IMPORTANTE: en producción la fuente de verdad debe ser el panel de Dokploy.
# Si alguna variable existe sólo en el servicio de Docker y no en el panel, el
# próximo deploy hecho desde el panel la borra y el servicio queda a medias.

# ── Chat con IA (Sofía) ──────────────────────────────────────────────────────
# El proveedor sólo tiene que exponer una API compatible con OpenAI
# (POST /chat/completions con streaming). Hoy se usa el gateway de opencode.
#
# Los nombres LLM_* son los vigentes. Las variables OPENROUTER_* siguen
# funcionando como alias para no romper despliegues existentes, pero conviene
# migrar: el gateway ya no es OpenRouter y el nombre confunde.

LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=

# Lista separada por comas, en orden de preferencia. Se intenta el primero y se
# pasa al siguiente si el proveedor rechaza ese modelo puntual (retirado,
# restringido por región, etc.). Un solo valor también es válido.
#
# Nota: si la respuesta es 401 por saldo agotado, NINGÚN modelo va a funcionar
# —el problema es de la cuenta, no del modelo— y el chat deriva a WhatsApp.
LLM_MODELS=mimo-v2.5,glm-5.2,kimi-k2.6

# Tope de tokens por respuesta. Los modelos que razonan antes de responder
# gastan tokens en ese paso: con un tope bajo, la respuesta llega vacía.
LLM_MAX_TOKENS=6000

# ── Correo (formulario de contacto y aviso de leads del chat) ────────────────
RESEND_API_KEY=
CONTACT_TO=comercial.proyectos@sgsolucionesing.com
CONTACT_CC=gestion.ofertas@sgsolucionesing.com
CONTACT_FROM=S&G Web <web@sgsolucionesing.com>

# ── Base de datos (historial del chat y leads) ──────────────────────────────
# Sin esta variable el chat responde igual, pero no guarda la conversación.
DATABASE_URL=

# ── Traducción de fichas de proyecto (script, no runtime) ───────────────────
# Sólo lo necesita `npm run translate`; el build de producción no lo usa.
OPENROUTER_API_KEY=
